# ---- Server ----
NODE_ENV=development
PORT=4000
# Public HTTPS address; Render supplies RENDER_EXTERNAL_URL automatically.
# Set PUBLIC_SITE_URL after attaching a custom domain.
PUBLIC_SITE_URL=
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# Comma-separated list of allowed browser origins for CORS.
# Use * to allow any origin during early development.
CORS_ORIGIN=*

# ---- Database (PostgreSQL) ----
# Local Docker (see docker-compose.yml):  postgres://revup:revup@localhost:5432/revup
# Neon / Supabase / RDS: paste their connection string (usually needs sslmode=require)
DATABASE_URL=postgres://revup:revup@localhost:5432/revup
# Set to true when your DB requires SSL (most hosted Postgres do)
DATABASE_SSL=false

# ---- Auth ----
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- Encryption at rest (POS API keys) ----
# 32+ random chars. If omitted in dev, a key is derived from JWT_SECRET (with a warning).
APP_ENCRYPTION_KEY=change-me-too-a-long-random-string

# ---- Billing ----
SUBSCRIPTION_PRICE_KZT=40000
FREE_REPORTS=1

# ---- POS integration ----
# When true, POS "sync" returns generated sample data so the flow works without
# real provider credentials. Set to false once a real provider client is wired in.
STUB_POS=true

# ---- Email (signup notifications) ----
# Where the "new registration" email is sent.
OWNER_NOTIFICATION_EMAIL=sajlauhanerezep3@gmail.com
# SMTP transport. If these are blank, emails are logged to the console instead of sent.
# For Gmail use an App Password (not your normal password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RevUp <no-reply@revup.kz>
